# Copy to .env and replace every value. Never commit .env.

# Postgres
POSTGRES_USER=vuonhoa
POSTGRES_PASSWORD=change-me-long-random
POSTGRES_DB=vuonhoa
# Host is "db" inside compose; from your machine use 127.0.0.1:55432 (dev port, avoids clashing with other local Postgres)
DATABASE_URL=postgres://vuonhoa:change-me-long-random@127.0.0.1:55432/vuonhoa
DATABASE_URL_TEST=postgres://vuonhoa:change-me-long-random@127.0.0.1:55432/vuonhoa_test

# Image storage (MinIO, S3 API)
S3_ENDPOINT=http://127.0.0.1:59100
S3_PUBLIC_URL=http://127.0.0.1:59100
S3_REGION=us-east-1
S3_BUCKET=vuonhoa
S3_ACCESS_KEY=vuonhoa-admin
S3_SECRET_KEY=change-me-long-random-too

# App
APP_URL=http://localhost:3000
SESSION_TTL_DAYS=30

# Production only
DOMAIN=vuonhoa.example
BACKUP_KEEP_DAYS=14
